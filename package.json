{
  "name": "article-drafting-tool",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "convex dev --start \"vite dev\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/lib/*.test.ts",
    "og": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --hide-scrollbars --window-size=1200,630 --user-data-dir=\"$(mktemp -d)\" --screenshot=public/og.png \"file://$PWD/scripts/og.html\"",
    "preview": "vite preview",
    "deploy": "convex deploy --cmd \"vite build\" --cmd-url-env-var-name VITE_CONVEX_URL && wrangler deploy"
  },
  "dependencies": {
    "@convex-dev/auth": "2.0.0",
    "@databuddy/sdk": "3.5.3",
    "@fontsource-variable/geist": "^5.3.0",
